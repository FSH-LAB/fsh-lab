import assert from "node:assert/strict";
import { setTimeout } from "node:timers/promises";
import { test } from "node:test";

const baseUrl = process.env.SMOKE_URL;
const commit = process.env.SHA;
assert.ok(baseUrl, "SMOKE_URL must point to a running app");
assert.match(commit ?? "", /^[0-9a-f]{40}$/, "SHA must be a full commit SHA");

async function request(path) {
  // Retry up to 30 times with 2s backoff (60s total polling window)
  for (let attempt = 0; ; attempt++) {
    try {
      const response = await fetch(new URL(path, baseUrl), {
        signal: AbortSignal.timeout(5_000),
      });
      if (!response.ok) {
        throw new Error(
          `${path} returned HTTP ${response.status}: ${await response.text().catch(() => "")}`,
        );
      }
      return await response.text();
    } catch (error) {
      if (attempt >= 30) throw error;
      await setTimeout(2_000);
    }
  }
}

test(
  "health reports the deployed commit and readiness",
  { timeout: 90_000 },
  async () => {
    const raw = await request("/api/health");
    const data = JSON.parse(raw);
    assert.equal(data.status, "ok", `Expected status: "ok", got: ${data.status}`);
    assert.equal(data.ready, true, "Application reports not ready");
    assert.equal(
      data.commit,
      commit,
      `Commit mismatch: expected ${commit}, got ${data.commit}`,
    );
  },
);

test("primary entrypoint responds", { timeout: 90_000 }, async () => {
  const content = await request("/");
  assert.ok(content.length > 0, "Root path returned empty body");
});

