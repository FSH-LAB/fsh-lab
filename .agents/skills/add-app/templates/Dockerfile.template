# Universal minimal container baseline for custom/polyglot starter apps
# Platform Contracts:
# 1. Listen on port 8080 (Cloud Run standard).
# 2. Run as an unprivileged/non-root user (UID 1000).
# 3. Read GIT_SHA environment variable for /api/health report.

FROM node:24-alpine AS runner
WORKDIR /app

COPY apps/__APP_NAME__/server.mjs ./

USER node
ENV PORT=8080
EXPOSE 8080

CMD ["node", "server.mjs"]
